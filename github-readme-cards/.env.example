# Crie um Personal Access Token em https://github.com/settings/tokens
# Escopo necessário: apenas leitura pública (read:user, public_repo) já é suficiente
GITHUB_TOKEN=coloque_seu_token_aqui

# Porta do servidor (opcional)
PORT=3000

# Cache em memória, em minutos (evita bater no rate limit da API do GitHub)
CACHE_MINUTES=30
